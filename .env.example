# Copy these values into your shell environment or a local .env file.
# Never commit a real API key.
MM_AI_PROVIDER=openai
MM_AI_API_STYLE=responses
MM_AI_BASE_URL=https://api.openai.com/v1
MM_AI_API_KEY=
MM_AI_MODEL=gpt-5.6-terra
MM_AI_TEMPERATURE=0.2
MM_AI_TIMEOUT=120

# DeepSeek-compatible alternative:
# MM_AI_PROVIDER=deepseek
# MM_AI_API_STYLE=chat
# MM_AI_BASE_URL=https://api.deepseek.com/v1
# MM_AI_MODEL=deepseek-chat
